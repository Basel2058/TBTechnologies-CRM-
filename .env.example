# انسخ هذا الملف إلى .env وعدّل القيم (للتشغيل على سيرفر عبر Docker)

# اسم النطاق الذي سيفتح منه النظام (افصل بفاصلة)
DJANGO_ALLOWED_HOSTS=crm.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.example.com
# 1 إذا كان النظام يعمل عبر https (موصى به عند فتحه من الإنترنت)
DJANGO_HTTPS=1

# اختياري: مفتاح سري ثابت. إذا تركته فارغاً يُنشأ تلقائياً ويُحفظ في مجلد data
DJANGO_SECRET_KEY=

# حساب المدير الأول (يُنشأ مرة واحدة فقط إذا لم يكن هناك أي حساب)
TBT_ADMIN_USERNAME=admin
TBT_ADMIN_PASSWORD=

TBT_COMPANY_NAME=TBT
